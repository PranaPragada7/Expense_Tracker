ANTHROPIC_API_KEY=replace_with_your_api_key
ANTHROPIC_MODEL=claude-sonnet-5
AGENT_EFFORT=medium

# Production-style API. The SQLite default is convenient for local use;
# Docker Compose overrides it with PostgreSQL.
DATABASE_URL=sqlite:///./expense_api.db
JWT_SECRET=replace_with_a_long_random_secret
ACCESS_TOKEN_MINUTES=60
APP_ENV=development
LOG_LEVEL=INFO

# Optional: use a database file outside the project directory.
# EXPENSE_DB=C:\path\to\expenses.db
